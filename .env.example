# Copy this file to .env.local and fill in your values.

# Public URL of the site (used for Stripe redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe secret key (https://dashboard.stripe.com/apikeys)
# Use sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=

# Demo mode: lets you click "Buy" and download notes WITHOUT paying.
# Only for local testing — set to false (or remove) before going live.
DEMO_MODE=true
